@page "/"
@using FilmDetails
@using Microsoft.EntityFrameworkCore
@inject FilmContext FilmContext
@inject NavigationManager NavigationManager

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<h3>Films Database</h3>
<hr />
<div class="d-flex justify-content-between align-items-center mb-3">
    <EditForm Model="newFilm" OnValidSubmit="AddFilm">
        <div>
            <label for="Title">Title:</label>
            <InputText id="Title" @bind-Value="newFilm.Title" />
        </div>
        <br>
        <div>
            <label for="Year">Year:</label>
            <InputNumber id="Year" @bind-Value="newFilm.Year" />
        </div>
        <br>
        <button type="submit" class="btn btn-success mt-3">Add Film</button>
    </EditForm>
</div>
<table class=" table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Year</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var film in films!)
        {
            <tr>
                <td>@film.Title</td>
                <td>@film.Year</td>
                <td>
                    <!-- Update Button -->
                    <button class="btn btn-primary" @onclick="() => NavigateToEdit(film.FilmID)">Update
                    </button>
                    <!-- Delete Button -->
                    <button class="btn btn-danger" @onclick="() => DeleteFilm(film.FilmID)">Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Film>? films;

    private Film newFilm = new Film();


    protected override async Task OnInitializedAsync()
    {
        films = await FilmContext.Films!.ToListAsync();
    }
    private void NavigateToEdit(int filmId)
    {
        NavigationManager.NavigateTo($"/update/{filmId}");
    }

    private async Task DeleteFilm(int filmId)
    {
        var filmToDelete = await FilmContext.Films!.FindAsync(filmId);
        if (filmToDelete != null)
        {
            FilmContext.Films.Remove(filmToDelete);
            await FilmContext.SaveChangesAsync();
            films = await FilmContext.Films.ToListAsync();
        }
    }

    private async Task AddFilm()
    {
        if (!string.IsNullOrWhiteSpace(newFilm.Title) && newFilm.Year > 0)
        {
            await FilmContext.Films!.AddAsync(newFilm);
            await FilmContext.SaveChangesAsync();
            films = await FilmContext.Films.ToListAsync();
            newFilm = new Film();
        }
    }
}
