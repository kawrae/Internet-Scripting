@page
@model project.Pages.Albums.IndexModel
@{
    ViewData["Title"] = "Albums";
}

<h2>Albums</h2>

<form method="get" class="mb-3">
    <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control"
        placeholder="Search by album or artist..." />
</form>

<a class="btn btn-success mb-3" href="/Albums/Create">Add New Album</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Artist</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var album in Model.Albums)
        {
            <tr>
                <td>@album.Title</td>
                <td>@album.Artist?.Name</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@album.AlbumId" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-page="Delete" asp-route-id="@album.AlbumId" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
