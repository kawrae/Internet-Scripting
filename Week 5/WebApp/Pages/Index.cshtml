@page
@model webApp.Pages.ViewActors
@using FilmDetails;
<!DOCTYPE html>

<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Document</title>
</head>

<body>
  <h1>@Model.Heading</h1>
  <table border="1">
    <tr>
      <th>Actor ID</th>
      <th>First Name</th>
      <th>Last Name</th>
      <th>&nbsp;</th>
      <th>&nbsp;</th>
    </tr>
    @foreach (Actor actor in @Model.Actors!)
    {
      <tr>
        <td>@actor.ActorID</td>
        <td>@actor.FirstName</td>
        <td>@actor.LastName</td>
        <td>
          <form action="~/Delete" method="POST">
            @Html.AntiForgeryToken()
            <input type="hidden" name="hdnActorID" value="@actor.ActorID">
            <input type="submit" value="Delete">
          </form>
        </td>
        <td>
          <a href="~/Update?actorId=@actor.ActorID">Update</a>
        </td>
      </tr>
    }
  </table>

  <form action="~/Insert" method="POST">
    @Html.AntiForgeryToken()
    <p>First Name:<input type="text" name="tbxFirstName"></p>
    <p>Last Name:<input type="text" name="tbxLastName"></p>
    <p><input type="submit" value="Insert"></p>
  </form>

</body>

</html>